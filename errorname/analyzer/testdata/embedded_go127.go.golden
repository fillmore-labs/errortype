//go:build go1.27

package testdata

import "errors"

type (
	// Deprecated: Use [EmbVError] instead.
	//go:fix inline
	EmbVErr   = EmbVError
	EmbVError struct{ msg string } // want ` suggestion: "EmbVError"$`

	// Deprecated: Use [EmbPError] instead.
	//go:fix inline
	EmbPErr   = EmbPError
	EmbPError struct{ msg string } // want ` suggestion: "EmbPError"$`

	// Deprecated: Use [EmbVContainerError] instead.
	//go:fix inline
	ErrEmbVContainer   = EmbVContainerError
	EmbVContainerError struct { // want ` suggestion: "EmbVContainerError"$`
		EmbVErr
	}

	// Deprecated: Use [EmbPContainerError] instead.
	//go:fix inline
	ErrEmbPContainer   = EmbPContainerError
	EmbPContainerError struct { // want ` suggestion: "EmbPContainerError"$`
		EmbPErr
	}
)

func (e EmbVError) Error() string { return e.msg }

func (e *EmbPError) Error() string { return e.msg }

func _() error {
	err1 := EmbVContainerError{msg: "boom 1"}
	_ = err1.EmbVErr

	err2 := &EmbPContainerError{msg: "boom 2"}
	_ = err2.EmbPErr

	return errors.Join(err1, err2)
}
