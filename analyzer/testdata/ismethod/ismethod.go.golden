//go:build go1.26

package ismethod

import "errors"

type MyError struct{ msg string }

type MyPError = *MyError

func (e MyPError) Error() string { return e.msg }

func (e MyPError) Is(err error) bool { // want `MyPError.* \(et:ias\)$`
	_, ok := err.(MyPError)
	return ok
}

func IsMyError(err error) bool { // want ` \(et:lgc\)$`
	_, ok := errors.AsType[MyPError](err)
	return ok
}
