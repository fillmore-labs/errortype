package testdata

import "errors"

type zError struct{}

func (zError) Error() string {
	return "z"
}

// A type rename keeps the "Error" suffix: the count is inserted before it.
type z2Error struct{} // want ` suggestion: "z2Error"$`

func (z2Error) Error() string {
	return "z"
}

var ErrSame = errors.New("same")

// Deprecated: Use [ErrSame2] instead.
var SameErr = ErrSame2

var ErrSame2 = errors.New("same too") // want ` suggestion: "ErrSame2"$`

type Error struct{}

func (Error) Error() string {
	return "error"
}

// Deprecated: Use [E2Error] instead.
//
//go:fix inline
type Err = E2Error

// The whole name is the "Error" suffix: the numbered variant keeps the visibility.
type E2Error struct{} // want ` suggestion: "E2Error"$`

func (E2Error) Error() string {
	return "e"
}

// An unexported type must not get an exported suggestion.
type eError struct{} // want ` suggestion: "eError"$`

func (eError) Error() string {
	return "e"
}
