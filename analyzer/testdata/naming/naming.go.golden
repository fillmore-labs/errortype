package naming

import "strconv"

// Deprecated: Use [NamedError] instead.
//
//go:fix inline
type ErrNamed = NamedError

type NamedError string // want ` \(et:nam\+\)$`

func (e NamedError) Error() string { return string(e) }

const (
	errSentinel NamedError = "sentinelError" // want ` \(et:nam\)$`

	errOtherSentinel = NamedError("otherSentinel") // want ` \(et:nam\)$`
)

// Deprecated: Use [RetryableError] instead.
//
//go:fix inline
type RetryableErr = RetryableError

type RetryableError interface { // want ` \(et:nam\+\)$`
	error
	Retryable() bool
}

// Deprecated: Use [NumError] instead.
//
//go:fix inline
type NumErr = NumError

type NumError int // want ` \(et:nam\+\)$`

func (e NumError) Error() string {
	return "error " + strconv.Itoa(int(e))
}

// Deprecated: Use [ErrNumErr0] instead.
//
//go:fix inline
const NumErr0 = ErrNumErr0

// Deprecated: Use [ErrNumErr1] instead.
//
//go:fix inline
const NumErr1 = ErrNumErr1

// Deprecated: Use [ErrNumErr2] instead.
//
//go:fix inline
const NumErr2 = ErrNumErr2

const (
	ErrNumErr0 NumError = 0    // want ` \(et:nam\)$`
	ErrNumErr1 NumError = iota // want ` \(et:nam\)$`
	ErrNumErr2                 // want ` \(et:nam\)$`
)

const (
	// Deprecated: Use [ErrNumErr3] instead.
	//go:fix inline
	NumErr3             = ErrNumErr3
	ErrNumErr3 NumError = 3 // want ` \(et:nam\)$`
	// Deprecated: Use [ErrNumErr4] instead.
	//go:fix inline
	NumErr4             = ErrNumErr4
	ErrNumErr4 NumError = 4 // want ` \(et:nam\)$`
	// Deprecated: Use [ErrNumErr5] instead.
	//go:fix inline
	NumErr5    = ErrNumErr5
	ErrNumErr5 = NumError(5) // want ` \(et:nam\)$`
)
