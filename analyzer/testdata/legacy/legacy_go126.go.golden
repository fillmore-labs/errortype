//go:build go1.26

package legacy

import (
	"errors"
	"fmt"
	"net"
)

func IsMyError6(err error) (ok bool) { // want ` \(et:lgc\)$`
	_, (ok) = errors.AsType[MyError](err)
	return
}

func IsMyError13(err error) bool { // want ` \(et:lgc\)$`
	_, ok = errors.AsType[MyError](err) // writes to package-level ok
	return ok
}

func IsMyError14(err error) (ok bool) { // want ` \(et:lgc\)$`
	errMy, ok = errors.AsType[MyError](err) // writes to package-level errMy
	return ok
}

func IsNetworkError2(err error) bool { // want ` \(et:lgc\)$`
	_, ok := errors.AsType[net.Error](err)
	return ok
}

func IsMyError15(err error) (ok bool) { // want ` \(et:lgc\)$`
	ok = errors.As(err, new(fmt.Stringer))
	return ok
}
