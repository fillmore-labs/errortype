package testdata

import "fmt"

type (
	my1Error int // want ` suggestion: "my1Error"$`
	// Deprecated: Use [My2Error] instead.
	//go:fix inline
	My2Err   = My2Error
	My2Error int // want ` suggestion: "My2Error"$`
)

func (e my1Error) Error() string {
	return fmt.Sprintf("my error %d", e)
}

func (e My2Error) Error() string {
	return fmt.Sprintf("my error %d", e)
}

var (
	errMy1 my1Error = 1 // want ` suggestion: "errMy1"$`
	// Deprecated: Use [ErrMy2] instead.
	My2             = ErrMy2
	ErrMy2 My2Error = 2 // want ` suggestion: "ErrMy2"$`
)

// Deprecated: Use [ErrMy3] instead.
//
//go:fix inline
const My3 = ErrMy3

// Deprecated: Use [ErrMy4] instead.
//
//go:fix inline
const My4 = ErrMy4

const (
	ErrMy3 my1Error = iota + 3 // want ` suggestion: "ErrMy3"$`
	ErrMy4                     // want ` suggestion: "ErrMy4"$`
	errMy5 My2Error = iota + 3 // want ` suggestion: "errMy5"$`
)

// Deprecated: Use [errMy] instead.
var myErr = errMy

// errMy is unexported, but used in a generated file.
var errMy my1Error // want ` suggestion: "errMy"$`

// Deprecated: Use [genError] instead.
//
//go:fix inline
type errGen = genError

// genError is unexported and used in a generated file,
// so it keeps its name behind an alias.
type genError struct{ msg string } // want ` suggestion: "genError"$`

func (e *genError) Error() string { return e.msg }
