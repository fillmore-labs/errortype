}

var errSentinel = errors.New("sentinel error") // want ` suggestion: "errSentinel"$`

// Deprecated: Use [NumError] instead.
//
//go:fix inline
type NumErr = NumError

type NumError int // want ` suggestion: "NumError"$`

func (e NumError) Error() string {
	return "error " + strconv.Itoa(int(e))
}

