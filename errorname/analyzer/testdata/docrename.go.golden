package testdata

// Deprecated: Use [DocError] instead.
//
//go:fix inline
type DocErr = DocError

// DocError wraps a value with no other interesting properties.
type DocError struct{} // want ` suggestion: "DocError"$`

func (DocError) Error() string { return "doc" }

// E8Error and E9Error are errors.
type (
	// Deprecated: Use [E8Error] instead.
	//go:fix inline
	Err8    = E8Error
	E8Error struct{} // want ` suggestion: "E8Error"$`
	// Deprecated: Use [E9Error] instead.
	//go:fix inline
	Err9    = E9Error
	E9Error struct{} // want ` suggestion: "E9Error"$`
)

func (E8Error) Error() string { return "err1" }

func (E9Error) Error() string { return "err2" }
