package testdata

import (
	"fmt"
	"strconv"
)

// Deprecated: Use [GenericError] instead.
//
//go:fix inline
type Errorgeneric[T interface {
	error
	fmt.Stringer
}] = GenericError[T]

// GenericError[T] is a generic error.
type GenericError[T interface { // want ` suggestion: "GenericError"$`
	error
	fmt.Stringer
}] struct{ v T }

func (e GenericError[T]) Error() string { return "error: " + e.v.String() }

type cError string // want ` suggestion: "cError"$`

func (e cError) String() string { return string(e) }

func (e cError) Error() string { return e.String() }

// Deprecated: Use [DError] instead.
//
//go:fix inline
type ErrD = DError

type DError int // want ` suggestion: "DError"$`

func (e DError) String() string { return strconv.Itoa(int(e)) }

func (e DError) Error() string { return e.String() }

var (
	errC GenericError[cError] = GenericError[cError]{v: "a"} // want ` suggestion: "errC"$`
	// Deprecated: Use [ErrD2] instead.
	Derror                      = ErrD2
	ErrD2  GenericError[DError] = GenericError[DError]{v: 1} // want ` suggestion: "ErrD2"$`
)
